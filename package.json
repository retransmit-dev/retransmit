{
  "name": "retransmit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @retransmit/db --",
    "db:studio": "turbo run db:studio -F @retransmit/db --",
    "db:generate": "turbo run db:generate -F @retransmit/db --",
    "db:migrate": "turbo run db:migrate -F @retransmit/db --"
  },
  "dependencies": {
    "@retransmit/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@retransmit/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.27.0"
}
