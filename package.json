{
  "name": "retransmit",
  "private": true,
  "license": "AGPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "with-env": "dotenv -e .env --",
    "dev": "pnpm with-env turbo run dev",
    "build": "pnpm with-env turbo run build",
    "check-types": "pnpm with-env turbo run check-types",
    "dev:web": "pnpm with-env turbo run dev -F web --",
    "dev:dashboard": "pnpm with-env turbo run dev -F dashboard --",
    "dev:api": "pnpm with-env turbo run dev -F api --",
    "dev:docs": "pnpm with-env turbo run dev -F docs --",
    "db:push": "pnpm with-env turbo run db:push -F @retransmit/db --",
    "db:studio": "pnpm with-env turbo run db:studio -F @retransmit/db --",
    "db:generate": "pnpm with-env turbo run db:generate -F @retransmit/db --",
    "db:migrate": "pnpm with-env turbo run db:migrate -F @retransmit/db --"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@retransmit/config": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "overrides": {
      "nextra>zod": "4.3.6",
      "nextra-theme-docs>zod": "4.3.6"
    }
  }
}
