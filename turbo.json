{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env"
  ],
  "globalEnv": [
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "DATABASE_URL",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "SES_CONFIGURATION_SET",
    "SES_SNS_TOPIC_ARN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "SES_MAX_SEND_RATE",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "TRANSACTIONAL_EMAIL_FROM",
    "MTN_CM_CONSUMER_KEY",
    "MTN_CM_CONSUMER_SECRET",
    "MTN_CM_SENDER_ADDRESS",
    "MTN_CM_SERVICE_CODE",
    "MTN_CM_REQUEST_DLR",
    "MTN_CM_COST_PER_SMS",
    "MTN_TOKEN_URL",
    "MTN_API_BASE_URL",
    "SMS_FORCE_PROVIDER",
    "SMS_ROUTES",
    "SMS_MAX_SEND_RATE",
    "SMS_CALLBACK_TOKEN",
    "ORANGE_CLIENT_ID",
    "ORANGE_CLIENT_SECRET",
    "ORANGE_CM_CLIENT_ID",
    "ORANGE_CM_CLIENT_SECRET",
    "ORANGE_CM_SENDER_ADDRESS",
    "ORANGE_CM_SENDER_NAME",
    "ORANGE_CM_COST_PER_SMS",
    "WHATSAPP_META_ACCESS_TOKEN",
    "WHATSAPP_META_PHONE_NUMBER_ID",
    "WHATSAPP_META_APP_SECRET",
    "WHATSAPP_META_VERIFY_TOKEN",
    "WHATSAPP_META_API_VERSION",
    "WHATSAPP_META_COST_PER_MESSAGE",
    "META_GRAPH_API_BASE_URL",
    "WHATSAPP_FORCE_PROVIDER",
    "WHATSAPP_MAX_SEND_RATE"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:push": {
      "cache": false,
      "interactive": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false,
      "interactive": true
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}